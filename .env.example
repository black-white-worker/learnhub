# 复制成 .env 后按需修改；不要提交真实的 .env
# cp .env.example .env

# ===== MySQL =====
# 本机若已有原生 MySQL 占用 3306，容器映射到 3316 避免冲突
DB_NAME=learningplatform
DB_PORT=3316
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ===== Redis =====
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_PORT=6381

# ===== 对外端口 =====
BACKEND_PORT=8888
HTTP_PORT=8088

# ===== MinIO =====
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=learningplatform
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9021
# 私有桶开关：true 时后端返回 30 分钟预签名 URL（推荐）；
# 关闭匿名读的策略由 compose 里的 minio-init 自动执行。
MINIO_PRIVATE=true

# ===== AI 模块（ai-service / ai-worker）=====
# Go ↔ Python 之间的共享密钥，两边必须同一个值。生成：openssl rand -hex 16
# 留空 = AI 功能整体关闭（/api/ai/* 回 503），站点其余功能不受影响。
AI_INTERNAL_TOKEN=change-me
# 通义千问 DashScope 密钥（只进 .env，不要提交）。旧密钥已进过 git 历史，请先在百炼控制台轮换。
DASHSCOPE_API_KEY=

# ===== AI 出题：简体中文专业题（默认，不配也能用）=====
# 按知识点检索免费中文权威资料（中文维基百科 / 中文维基教科书，CC BY-SA 4.0，
# 免注册、免 API Key，variant=zh-cn 直接取简体）作为事实依据，再由模型命制带解析、
# 带依据编号的专业课题目；英文整句/繁体/空壳常识题判废重出，题库与历史题干跨请求去重。
# 资料检索失败或无匹配时自动退回「纯模型中文专业出题」，不阻塞生成按钮。
# ZH_MATERIAL_ENABLED=true             # 中文资料检索总开关（关闭=纯模型出题）
# ZH_MATERIAL_TIMEOUT=4                # 检索超时（秒）
# ZH_MATERIAL_MAX_DOCS=4               # 每次检索最多取几个条目
# ZH_MATERIAL_MAX_SNIPPETS=3           # 注入 prompt 的素材段落数
# ZH_MATERIAL_WIKIBOOKS_ENABLED=true   # 主源无结果时补查中文维基教科书
# GENERATE_REQUIRE_CHINESE=true        # 中文 / 专业度硬校验（英文整句题干判废）
# GENERATE_MAX_ATTEMPTS=2              # 不合格/重复时换随机蓝图重试几次
# 前端「学科」下拉对应 subject（术语与检索限定），「引用中文资料」对应 grounding。
# 资料与题库内容均为 CC BY-SA 4.0，返回体保留 provider / materials 便于署名。

# ===== 可选：英文通识题库（仅课堂热身，不按知识点出题）=====
# 只有在 AI 出题页把「题目来源」切到「通识热身」才会使用；英文原题由 AI 汉化。
# 需要按知识点出的中文专业题时不要切到该模式。
# QUESTION_BANK_ENABLED=true       # 题库能力总开关
# QUESTION_BANK_INSPIRE=false      # 给 AI 出题注入题库风格样例（多一次外网请求，默认关）
# QUESTION_BANK_LOCALIZE=true      # 英文题库题用 LLM 翻成中文；关掉则保留英文
# QUESTION_BANK_TIMEOUT=6          # 题库请求超时（秒）

# ===== MongoDB（AI 知识库主存储，只在 docker 内网，不映射端口）=====
# 本地保持无认证即可；上线在 .env.prod 里配 MONGO_ROOT_USER / MONGO_ROOT_PASSWORD，
# 并同步打开 compose 里 mongo 服务与 ai-service 的认证相关注释。
# MONGO_ROOT_USER=
# MONGO_ROOT_PASSWORD=
