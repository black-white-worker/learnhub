# 复制成 .env 后按需修改；不要提交真实的 .env
# cp .env.example .env

# ===== MySQL =====
# 本机若已有原生 MySQL 占用 3306，容器映射到 3316 避免冲突
DB_NAME=learningplatform
DB_PORT=3316
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ===== Redis =====
REDIS_USERNAME=default
REDIS_PASSWORD=change-me
REDIS_PORT=6381

# ===== 对外端口 =====
BACKEND_PORT=8888
HTTP_PORT=8088

# ===== MinIO =====
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=learningplatform
MINIO_API_PORT=9020
MINIO_CONSOLE_PORT=9021
# 私有桶开关：true 时后端返回 30 分钟预签名 URL（推荐）；
# 关闭匿名读的策略由 compose 里的 minio-init 自动执行。
MINIO_PRIVATE=true
