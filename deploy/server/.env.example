# =====================================================================
# 共享中间件环境变量
# 用法：cp .env.example .env && chmod 600 .env
# 这里的密码必须和三个项目各自的 .env.prod 保持一致！
# =====================================================================

# 服务器公网 IP（预签名 URL / CORS / 前端构建都会用到）
PUBLIC_HOST=101.201.208.223

# ---- MySQL（learningplatform + videonest）----
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root

# ---- PostgreSQL（heart-pilot，需 pgvector）----
PG_USER=heart_pilot
PG_PASSWORD=CHANGE_ME_pg

# ---- Redis（三个项目共用，用 database 号隔离）----
REDIS_PASSWORD=CHANGE_ME_redis

# ---- MinIO（三个桶共用一套账号）----
MINIO_ROOT_USER=lpminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
