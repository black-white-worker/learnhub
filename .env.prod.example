# learningplatform 服务器环境变量
# 用法：cp .env.prod.example .env.prod && chmod 600 .env.prod
# 密码必须和 deploy/server/.env 里的一致（共用同一套中间件）

PUBLIC_HOST=101.201.208.223

# 对外端口：80 = http://101.201.208.223/
HTTP_PORT=80

# ---- 数据库（共享 MySQL，库名固定）----
DB_NAME=learningplatform
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root

# ---- Redis（共享实例，密码一致；go-zero 固定用 db0）----
REDIS_PASSWORD=CHANGE_ME_redis

# ---- MinIO（共享实例，桶名独立）----
MINIO_ACCESS_KEY=lpminio
MINIO_SECRET_KEY=CHANGE_ME_minio
MINIO_BUCKET=learningplatform
# true = 私有桶，接口返回 30 分钟预签名 URL（推荐）
MINIO_PRIVATE=true

# ===== AI 模块（ai-service / ai-worker）=====
# Go ↔ Python 之间的共享密钥，两边必须同一个值。生成：openssl rand -hex 16
# 留空 = AI 功能整体关闭（/api/ai/* 回 503），站点其余功能不受影响。
AI_INTERNAL_TOKEN=change-me
# 通义千问 DashScope 密钥（只进 .env，不要提交）。旧密钥已进过 git 历史，请先在百炼控制台轮换。
DASHSCOPE_API_KEY=

# ===== MongoDB（AI 知识库，只在 docker 内网，不映射端口）=====
# 启用步骤：① 填下面两个值；② 取消 docker-compose.yml 里 mongo 服务
# MONGO_INITDB_ROOT_* 的注释；③ 取消 ai-service 里 MONGODB_USERNAME/PASSWORD/
# AUTH_SOURCE/TLS 的注释并把 MONGODB_STRICT 改为 true。
MONGO_ROOT_USER=CHANGE_ME_mongo_user
MONGO_ROOT_PASSWORD=CHANGE_ME_mongo_pass
