# learningplatform 服务器环境变量
# 用法：cp .env.prod.example .env.prod && chmod 600 .env.prod
# 密码必须和 deploy/server/.env 里的一致（共用同一套中间件）

PUBLIC_HOST=101.201.208.223

# 对外端口：80 = http://101.201.208.223/
HTTP_PORT=80

# ---- 数据库（共享 MySQL，库名固定）----
DB_NAME=learningplatform
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root

# ---- Redis（共享实例，密码一致；go-zero 固定用 db0）----
REDIS_PASSWORD=CHANGE_ME_redis

# ---- MinIO（共享实例，桶名独立）----
MINIO_ACCESS_KEY=lpminio
MINIO_SECRET_KEY=CHANGE_ME_minio
MINIO_BUCKET=learningplatform
# true = 私有桶，接口返回 30 分钟预签名 URL（推荐）
MINIO_PRIVATE=true
