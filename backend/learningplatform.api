syntax = "v1"

type Request {
	Name string `path:"name,options=you|me"`
}

type Response {
	Message string `json:"message"`
}

type LoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type LoginResponse {
	Token    string `json:"token"`
	Username string `json:"username"`
}

type RegisterRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type RegisterResponse {
	Username string `json:"username"`
}

// 登出接口（需登录，token 放在 Authorization: Bearer 头）
type LogoutResponse {
	Username string `json:"username"`
}

// 当前用户信息接口（需登录）
type InfoResponse {
	Username string `json:"username"`
	Nickname string `json:"nickname"`
}

service learningplatform-api {
	@handler LearningplatformHandler
	get /api/from/:name (Request) returns (Response)

	@handler LoginHandler
	post /api/user/login (LoginRequest) returns (LoginResponse)

	@handler RegisterHandler
	post /api/user/register (RegisterRequest) returns (RegisterResponse)

	@handler LogoutHandler
	post /api/user/logout () returns (LogoutResponse)

	@handler InfoHandler
	get /api/user/info () returns (InfoResponse)
}

