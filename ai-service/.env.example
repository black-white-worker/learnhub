# AI 服务环境变量模板：复制成 .env 再填真实值，不要把 .env 提交到仓库。
#
# 本地直跑：cp .env.example .env；下面默认值就能跑，MongoDB 没启动会自动降级为内存知识库。
# 容器部署：这些值由仓库根目录 docker-compose.yml 注入，不需要这个 .env。
#
# 注意：仓库里曾存在过提交了真实 DashScope Key 的 .env 与 docker-compose.yml，
# 如果这个仓库被推送过，请到控制台把那个 Key 作废并重新生成。

# ===== LLM（通义千问 DashScope 兼容模式）=====
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60
# 本机 ollama 跑 qwen2.5:7b 时改成：
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_API_KEY=not-needed
#   LLM_MODEL=qwen2.5:7b

# ===== Embedding =====
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 单批条数：DashScope text-embedding-v3 上限 10，超过会 400 导致整份讲义灌库失败
EMBEDDING_BATCH_SIZE=10

# ===== 基础设施 =====
# 带密码的 Redis 要写成 redis://:密码@redis:6379/0，否则 AUTH 失败
REDIS_URL=redis://:your-redis-pass@redis:6379/0
VECTOR_DB_DIR=./data/chroma

# ===== MongoDB：RAG 知识库主存储 =====
# 文档/切片/灌入状态/未答日志/GridFS 原文件都在这里，不再是死配置。
MONGODB_ENABLED=true
# 本地 false（Mongo 挂了自动降级，服务不崩）；上线务必 true（连不上直接失败，不静默丢数据）
MONGODB_STRICT=false
MONGODB_URL=mongodb://127.0.0.1:27017
# 容器内是 mongodb://mongo:27017；副本集写 mongodb://mongo-0:27017,mongo-1:27017
MONGODB_DB=ai_service
# 上线认证：也可把 user:pass 直接写进 URL；单独留字段便于密钥管理
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_REPLICA_SET=
MONGODB_TLS=false
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
MONGODB_CONNECT_TIMEOUT_MS=2000

# ===== MySQL：只有 scripts/ingest.py 读课程资源元数据 =====
# 本地直跑用 127.0.0.1:3316（compose 映射端口）；容器内由 compose 注入 mysql:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=learningplatform
MYSQL_CONNECT_TIMEOUT=5

# ===== MinIO：ingest 拉课程原文件 =====
# 配了 AK/SK 就按 object_name 走 SDK（私有桶正解）；没配则退回资源 URL 的 HTTP GET。
MINIO_ENDPOINT=127.0.0.1:9020
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=learningplatform
MINIO_SECURE=false
# 本地离线调试：把 object_name 映射到这个目录下的文件（留空则不启用）
# 容器内请用相对路径（如 data/ingest_local）；Windows Git Bash 会把 /app/... 自动转换成本机路径
INGEST_LOCAL_FILE_ROOT=
INGEST_FETCH_TIMEOUT=15

# ===== 知识库集合与灌入 =====
KB_COLLECTION_PREFIX=kb
KB_GRIDFS_BUCKET=kb_files
INGEST_CHUNK_SIZE=500
INGEST_CHUNK_OVERLAP=50
INGEST_MAX_FILE_BYTES=52428800
INGEST_PARSE_PDF=true
INGEST_PARSE_DOCX=true
# 配套 SRT/VTT 字幕：有字幕就能灌入视频正文（视频本体 STT 仍未实现）
INGEST_PARSE_SUBTITLE=true
# 视频 STT（ffmpeg 抽音频 + ASR）尚未实现，保持 false，不要误以为已支持
INGEST_PARSE_VIDEO=false
INGEST_DRY_RUN=false

# ===== 混合检索 =====
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_VECTOR_TOP_K=3
RETRIEVAL_LEXICAL_TOP_K=3
RETRIEVAL_RRF_K=60
RETRIEVAL_LEXICAL_MIN_TOKENS=1
RETRIEVAL_LOG_UNANSWERED=true
RETRIEVAL_MAX_QUERY_CHARS=500

# ===== 服务与鉴权 =====
GO_CALLBACK_BASE=http://backend:8888
GRADE_QUEUE=ai:grade:queue
# 必须与 Go 侧 AI_INTERNAL_TOKEN 同值；留空且开关打开时所有接口返回 403
INTERNAL_TOKEN=
INTERNAL_AUTH_ENABLED=true
DAILY_TOKEN_LIMIT=100

# ---------------------------------------------------------------------------
# 上线服务器必配清单（.env.prod / compose environment 里覆盖）
#  1. MONGODB_STRICT=true + MONGODB_URL 指向副本集 + MONGODB_USERNAME/PASSWORD/AUTH_SOURCE
#     + MONGODB_TLS=true + 连接池/超时；mongo 容器启用 MONGO_INITDB_ROOT_* 且不映射端口。
#  2. MYSQL_* 用只读账号（ingest 只需要 SELECT course_resources）。
#  3. MINIO_* 用内网 endpoint minio:9000 + 独立 AK/SK。
#  4. INTERNAL_TOKEN、LLM_API_KEY、REDIS_URL 全部由密钥管理注入，绝不进 git。
#  5. 就绪探针看 /readyz（会显示 backend / degraded），存活探针只看 /health。
#  6. 上线前执行一次 python -m scripts.ingest --course-id <id> 灌库，
#     再用 GET /api/ai/kb/status?course_id=<id> 核对 parsed/fallback/unanswered_queries。
# ---------------------------------------------------------------------------
